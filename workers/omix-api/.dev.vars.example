# Copy to .dev.vars for local `wrangler dev`.
# D1 + R2 bindings come from wrangler.toml (create them once via
# `wrangler d1 create omix-db` and `wrangler r2 bucket create omix-assets`).

ABLY_API_KEY=your-ably-key
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Omix Community <onboarding@resend.dev>
APP_ORIGIN=http://localhost:3000
# TOKEN_AUTH_SECRET=optional-shared-secret
