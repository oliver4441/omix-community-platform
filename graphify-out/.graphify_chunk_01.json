    {"id": "docs_constitution_core_philosophy", "label": "Core Philosophy", "file_type": "rationale", "source_file": "docs/CONSTITUTION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every decision must prioritize speed, simplicity, reliability, privacy, accessibility, mobile-first and offline-first; do not implement features that add complexity without clear user value."},
    {"id": "docs_constitution_tech_stack", "label": "Technology Stack", "file_type": "concept", "source_file": "docs/CONSTITUTION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Next.js framework, Vercel hosting, Firebase Authentication, Cloud Firestore, Firebase Storage, Firebase Cloud Messaging, Jitsi Meet, IndexedDB offline storage, Service Worker PWA."},
    {"id": "docs_constitution_design_system", "label": "Design System", "file_type": "concept", "source_file": "docs/CONSTITUTION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dark-first theme, 20px corners, 8-point spacing grid, subtle animation, readable typography, Lucide icons, purple primary with blue accent on very dark navy background."},
    {"id": "docs_constitution_performance_budget", "label": "Performance Budget", "file_type": "rationale", "source_file": "docs/CONSTITUTION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Initial load <150KB JS, time-to-interactive <3s on average mobile networks, instant navigation, lazy-loaded images, virtualized lists, 60 FPS animations."},
    {"id": "docs_constitution_pwa_rules", "label": "PWA Rules", "file_type": "rationale", "source_file": "docs/CONSTITUTION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Must be installable, work offline, cache navigation, support push notifications and background sync, and survive network interruption."},
    {"id": "docs_constitution_security", "label": "Security Rules", "file_type": "rationale", "source_file": "docs/CONSTITUTION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never trust client input, validate everything, least-privilege access, use Firestore Security Rules, encrypt private chats, never expose secrets or commit API keys."},
    {"id": "docs_constitution_architecture_rules", "label": "Architecture Rules", "file_type": "rationale", "source_file": "docs/CONSTITUTION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Modular architecture, feature-based folders, strict TypeScript, reusable components, lazy loading, code splitting; never monolithic components, massive files, duplicate logic, inline styles or hardcoded colors/endpoints."},
