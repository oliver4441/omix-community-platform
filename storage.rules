rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.size < 20 * 1024 * 1024;
    }
    match /icons/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.size < 2 * 1024 * 1024;
    }
    match /avatars/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.size < 2 * 1024 * 1024;
    }
  }
}
